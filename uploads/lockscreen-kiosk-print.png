<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8" />
<title>Job Seeker Kiosk lock screen</title>
<style>
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #fff; }
  body { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 0.4in; font-family: system-ui, sans-serif; }
  .frame { width: 100%; max-width: 100%; display: flex; align-items: center; justify-content: center; }
  img.shot { width: 100%; height: auto; max-height: calc(100vh - 0.8in); object-fit: contain; display: block; box-shadow: 0 1px 0 rgba(0,0,0,0.12); }

  @page { size: letter landscape; margin: 0; }
  @media print {
    body { padding: 0.4in; }
    .frame { page-break-inside: avoid; break-inside: avoid; }
  }
</style>
</head>
<body>
  <div class="frame">
    <img class="shot" src="lockscreen-kiosk.png" alt="Job Seeker Kiosk lock screen — kiosk-MOCKSERIAL@apm.net.au" />
  </div>
<script>
addEventListener('load', () => {
  (async () => {
    try { await document.fonts.ready; } catch (e) {}
    const imgs = Array.from(document.images).filter((i) => !i.complete);
    await Promise.race([
      Promise.allSettled(imgs.map((i) => i.decode())),
      new Promise((r) => setTimeout(r, 8000)),
    ]);
    setTimeout(() => window.print(), 500);
  })();
});
</script>
</body>
</html>
