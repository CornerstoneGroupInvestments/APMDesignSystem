<w:comments xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:comment w:id="16" w:author="Nick Dorbie" w:date="2026-08-11T10:17:00Z" w:initials="ND"><w:p w14:paraId="35BC9DDC" w14:textId="607CF598" w:rsidR="00CC569F" w:rsidRDefault="00CC569F"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:Shaun.Struik@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="18" w:name="_@_03CC7E3AE49B42CABAE1ECD2372F73F3Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="18"/><w:r w:rsidRPr="275930EF"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Shaun Struik</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="4DB30CD4"><w:t xml:space="preserve"> Can you please confirm if this has been added to the assigned access XML?</w:t></w:r></w:p></w:comment><w:comment w:id="17" w:author="Nick Dorbie" w:date="2026-08-11T10:31:00Z" w:initials="ND"><w:p w14:paraId="68D1882C" w14:textId="266880ED" w:rsidR="008F23E4" w:rsidRDefault="008F23E4"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r w:rsidRPr="1986DFC4"><w:t xml:space="preserve">Noting this has been covered in </w:t></w:r><w:r w:rsidRPr="6B56F504"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>4.3.1.1</w:t></w:r></w:p></w:comment><w:comment w:id="19" w:author="Nick Dorbie" w:date="2026-08-11T10:19:00Z" w:initials="ND"><w:p w14:paraId="473A4A77" w14:textId="125F8D7D" w:rsidR="00EE29EC" w:rsidRDefault="00EE29EC"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:Shaun.Struik@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="20" w:name="_@_F628FE56FD604D1B87FE4E2A9A392FD6Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="20"/><w:r w:rsidRPr="6039461F"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Shaun Struik</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="1F86C73A"><w:t xml:space="preserve"> note to ensure that Kiosk Device group is set to be excluded from Office package installation.</w:t></w:r></w:p></w:comment><w:comment w:id="24" w:author="Nick Dorbie" w:date="2026-08-11T10:24:00Z" w:initials="ND"><w:p w14:paraId="0B565FAF" w14:textId="23E48702" w:rsidR="00E3139D" w:rsidRDefault="00E3139D"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:Chris.Katigbak@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="25" w:name="_@_9DC2FF1D29334CC99FCB9CF5DDD4F2D8Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="25"/><w:r w:rsidRPr="2DE05788"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Chris Katigbak</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="62078AEF"><w:t xml:space="preserve"> </w:t></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:David.Badger@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="26" w:name="_@_70557020B80546CF9C4D2ECCC1D02585Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="26"/><w:r w:rsidRPr="7412D7A6"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@David Badger</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="2E9AD7C8"><w:t xml:space="preserve"> noting that this may change to EAP - TLS authentication as per request by Chris to follow Network best practice</w:t></w:r></w:p></w:comment><w:comment w:id="33" w:author="Nick Dorbie" w:date="2026-08-05T11:21:00Z" w:initials="ND"><w:p w14:paraId="4FF8EF42" w14:textId="114AC2CD" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r w:rsidRPr="09A443EF"><w:t>Please confirm if devices register as having same login account that this will not affect Zscaler licensing.</w:t></w:r></w:p></w:comment><w:comment w:id="34" w:author="David Badger" w:date="2026-08-06T11:32:00Z" w:initials="DB"><w:p w14:paraId="5BB244EE" w14:textId="628DEF3F" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:Phil.Death@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="41" w:name="_@_11C8D346C14844818000892553B8C3CAZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="41"/><w:r w:rsidRPr="38461652"><w:rPr><w:noProof/></w:rPr><w:t>@Phil De'ath</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></w:comment><w:comment w:id="35" w:author="Phil De'ath" w:date="2026-08-06T10:07:00Z" w:initials="PD"><w:p w14:paraId="7DF35F9F" w14:textId="35CE4455" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r w:rsidRPr="7265A6E8"><w:t>I'm still trying to work the overall solution through with ZSscaler. There are a few considerations that may affect licensing (it shouldn't increase it past what has already been purchased, but may reduce it).</w:t></w:r></w:p><w:p w14:paraId="31394856" w14:textId="549FC369" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r w:rsidRPr="16B01142"><w:t>But in the context of this question, I was expecting the accounts to be named differently (using the machine name).</w:t></w:r></w:p></w:comment><w:comment w:id="36" w:author="Shaun Struik" w:date="2026-08-06T12:51:00Z" w:initials="SS"><w:p w14:paraId="05AC109F" w14:textId="4EC1039B" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Phil.Death@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="42" w:name="_@_CD11155BC510431FAA73733DE2A184F4Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="42"/><w:r w:rsidRPr="00500780"><w:rPr><w:noProof/></w:rPr><w:t>@Phil De'ath</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve"> I have tried to keep the signin as simple ass possible, Std Auto Login Kiosk and no password. We can’t have an O365 user account sign in as that would need user licencing where as I’ve designed as An Intune device licence</w:t></w:r></w:p></w:comment><w:comment w:id="37" w:author="Shaun Struik" w:date="2026-08-06T12:51:00Z" w:initials="SS"><w:p w14:paraId="3583A2B7" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:t>Zscaler can be used on the Win 11 Enterprise OS, so it’s a matter of what Zscaler licence is required for device based licences</w:t></w:r></w:p></w:comment><w:comment w:id="38" w:author="Phil De'ath" w:date="2026-08-06T10:59:00Z" w:initials="PD"><w:p w14:paraId="03B6DBD4" w14:textId="4D4A10CB" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r w:rsidRPr="27AA0709"><w:t>It doesn't need an o365 account, but the username (currently) needs to be identifiable. as you are creating the local account, can you not just name it based on the machine name?</w:t></w:r></w:p><w:p w14:paraId="4CBC4678" w14:textId="0872D85E" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r w:rsidRPr="447F35CC"><w:t>The device based licensing it what I'm looking at with zscaler. at the moment, even the existing JS machines are user based license, but device based auth. Rule are also only applied to groups at the moment.</w:t></w:r></w:p></w:comment><w:comment w:id="39" w:author="Shaun Struik" w:date="2026-08-06T18:14:00Z" w:initials="SS"><w:p w14:paraId="7545903C" w14:textId="77A136FF" w:rsidR="00C21989" w:rsidRDefault="00C21989" w:rsidP="00C21989"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Phil.Death@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="43" w:name="_@_CA5D425AA80C4E7B9138F686F0138A5BZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="43"/><w:r w:rsidRPr="00C21989"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Phil De'ath</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve"> I have adjusted the design to have the naming convention Kiosk-&lt;SERIAL&gt;</w:t></w:r></w:p></w:comment><w:comment w:id="40" w:author="Phil De'ath" w:date="2026-08-06T16:17:00Z" w:initials="PD"><w:p w14:paraId="4A643F40" w14:textId="6018444A" w:rsidR="00B40EFE" w:rsidRDefault="00B40EFE"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r w:rsidRPr="0F66F1CA"><w:t>That should help, we are still working with zscaler to come up with the solution, but the unique naming will resolve the max number of devices per user problem.</w:t></w:r></w:p></w:comment><w:comment w:id="44" w:author="Nick Dorbie" w:date="2026-08-11T10:32:00Z" w:initials="ND"><w:p w14:paraId="06B264B1" w14:textId="0871D3F6" w:rsidR="004364DD" w:rsidRDefault="004364DD"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:Shaun.Struik@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="45" w:name="_@_89360435ABD940C2A4864D6A200EDD3BZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="45"/><w:r w:rsidRPr="13ADCCE1"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Shaun Struik</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="02BA758B"><w:t xml:space="preserve"> is there a way this can be turned into a shortcut instead of relying on a participant to follow a keyboard sequence? Otherwise an accessibility how-to-guide will need to be created which can be displayed beside the machine.</w:t></w:r></w:p></w:comment><w:comment w:id="46" w:author="Nick Dorbie" w:date="2026-08-05T11:12:00Z" w:initials="ND"><w:p w14:paraId="4CBD3FC3" w14:textId="1301C516" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r w:rsidRPr="19F4EF63"><w:t>Can either the Desktop or Downloads folder also be scoped into File Explorer for easy of access for partipants who may download documents</w:t></w:r></w:p></w:comment><w:comment w:id="47" w:author="David Badger" w:date="2026-08-06T11:31:00Z" w:initials="DB"><w:p w14:paraId="54D0C624" w14:textId="54B88E18" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r w:rsidRPr="4E776278"><w:t xml:space="preserve">Confirming - save to local hard drive? </w:t></w:r></w:p><w:p w14:paraId="49705E54" w14:textId="71ADF534" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r w:rsidRPr="1E8FBD5A"><w:t>Script to delete this at the end of each session will need to be incorporated</w:t></w:r></w:p></w:comment><w:comment w:id="48" w:author="Nick Dorbie" w:date="2026-08-06T11:37:00Z" w:initials="ND"><w:p w14:paraId="612C5632" w14:textId="4100C873" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r w:rsidRPr="680BA6FE"><w:t>Yes that is correct, we need to ensure that the solution is easy for users to navigate as most do not have a firm grasp of how to use technology</w:t></w:r></w:p></w:comment><w:comment w:id="49" w:author="Shaun Struik" w:date="2026-08-06T18:14:00Z" w:initials="SS"><w:p w14:paraId="461E48A7" w14:textId="005E370B" w:rsidR="00C21989" w:rsidRDefault="00C21989" w:rsidP="00C21989"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Nick.Dorbie@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="50" w:name="_@_89928C1C715444478368938CB00464BBZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="50"/><w:r w:rsidRPr="00C21989"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Nick Dorbie</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve"> both are added and XML adjusted accordingly</w:t></w:r></w:p></w:comment><w:comment w:id="66" w:author="Nick Dorbie" w:date="2026-08-11T10:42:00Z" w:initials="ND"><w:p w14:paraId="728D4B6A" w14:textId="3EA0E7A5" w:rsidR="00826EC1" w:rsidRDefault="00826EC1"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r w:rsidRPr="04F14ACC"><w:t>Can we please add to the documentation that the BIOS password be changed from the ThinClient default to the APM specific BIOS password?</w:t></w:r></w:p></w:comment><w:comment w:id="67" w:author="Nick Dorbie" w:date="2026-08-11T10:41:00Z" w:initials="ND"><w:p w14:paraId="12324BFF" w14:textId="0AE9CA37" w:rsidR="00B81EEE" w:rsidRDefault="00B81EEE"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:Shaun.Struik@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="69" w:name="_@_8DE1E520F440435C82380B34D3CA248EZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="69"/><w:r w:rsidRPr="1CA52809"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Shaun Struik</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="0C1698DF"><w:t xml:space="preserve"> </w:t></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:David.Badger@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="70" w:name="_@_8FEE99B05EAA40219D47A3496E36BB92Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="70"/><w:r w:rsidRPr="0828F7D1"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@David Badger</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="3C3351E8"><w:t xml:space="preserve"> is still still a requirement? I believe that there should no longer need to be a requirement that a device needs to be locked to a specific location and as long as they are assigned the appropriate Group Tag in Intune that they will receive all required policies.</w:t></w:r></w:p></w:comment><w:comment w:id="68" w:author="Shaun Struik" w:date="2026-08-11T11:51:00Z" w:initials="SS"><w:p w14:paraId="10AE33FA" w14:textId="42221812" w:rsidR="0079199D" w:rsidRDefault="0079199D" w:rsidP="0079199D"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Nick.Dorbie@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="71" w:name="_@_E3B172D318BA4D4FBD8A12CA4A0A5308Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="71"/><w:r w:rsidRPr="0079199D"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Nick Dorbie</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve"> this was more a solution to assist with asset management. Knowing that the devices are in a group named by the LOC# will always let you know the device type / use and its location.</w:t></w:r></w:p><w:p w14:paraId="4FC945D0" w14:textId="77777777" w:rsidR="0079199D" w:rsidRDefault="0079199D" w:rsidP="0079199D"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:t>Do you not require this?</w:t></w:r></w:p></w:comment><w:comment w:id="83" w:author="Chris Katigbak" w:date="2026-08-06T08:59:00Z" w:initials="CK"><w:p w14:paraId="260286DA" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:t>Do we have any PSK lifecycle management at the moment?</w:t></w:r></w:p><w:p w14:paraId="49FC2206" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"/><w:p w14:paraId="4B2DE56F" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:t>Is the use of PSK vs EAP-TLS driven by isolation requirements? Just asking as I wasn’t around before.</w:t></w:r></w:p></w:comment><w:comment w:id="84" w:author="David Badger" w:date="2026-08-06T11:35:00Z" w:initials="DB"><w:p w14:paraId="781E25EB" w14:textId="38293334" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:Chris.Katigbak@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="86" w:name="_@_5072A73CCFA3452ABA843B2A4CA53C4CZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="86"/><w:r w:rsidRPr="6B575CBC"><w:rPr><w:noProof/></w:rPr><w:t>@Chris Katigbak</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="35FA7F70"><w:t xml:space="preserve"> we did not have a network design prior to you coming on board.  </w:t></w:r></w:p><w:p w14:paraId="6B84FED0" w14:textId="1AC1FC51" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r w:rsidRPr="7DD55C77"><w:t>We will follow your lead on design recommendations - please adjust as necessary.</w:t></w:r></w:p></w:comment><w:comment w:id="85" w:author="Chris Katigbak" w:date="2026-08-06T14:20:00Z" w:initials="CK"><w:p w14:paraId="376499B0" w14:textId="06C5106F" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:t xml:space="preserve">Hi </w:t></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Nick.Dorbie@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="87" w:name="_@_28B0CE1CD48A48FFA57BC49B101BA5E2Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="87"/><w:r w:rsidRPr="007D4241"><w:rPr><w:noProof/></w:rPr><w:t>@Nick</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Phil.Death@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="88" w:name="_@_5321BA26E1384818AFEA414033A60D2BZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="88"/><w:r w:rsidRPr="007D4241"><w:rPr><w:noProof/></w:rPr><w:t>@Phil</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve"> , are you able to share your thoughts on this? Can we potentiall deploy device certs for EAP-TLS WIFI instead of PSK? Thanks!</w:t></w:r></w:p></w:comment><w:comment w:id="89" w:author="Ugbaad Adani" w:date="2026-08-07T14:49:00Z" w:initials="UA"><w:p w14:paraId="0EFDE8F0" w14:textId="77CF5796" w:rsidR="00A3766A" w:rsidRDefault="00A3766A"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r w:rsidRPr="3EFAD08C"><w:t>are we still using palos?</w:t></w:r></w:p></w:comment><w:comment w:id="90" w:author="Shaun Struik" w:date="2026-08-11T11:53:00Z" w:initials="SS"><w:p w14:paraId="298D4673" w14:textId="633559F0" w:rsidR="00172769" w:rsidRDefault="00172769" w:rsidP="00172769"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Ugbaad.Adani@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="91" w:name="_@_D45E17909C5847C89D07EDD71B88692DZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="91"/><w:r w:rsidRPr="00172769"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Ugbaad Adani</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve"> As discussed, I don’t feel we need to as no password rotation and full Windows 11 image allows Zscaler agent. P{Lease confirm you are happy with the deletion of Palo from this design</w:t></w:r></w:p></w:comment><w:comment w:id="92" w:author="Chris Katigbak" w:date="2026-08-12T10:29:00Z" w:initials="CK"><w:p w14:paraId="2DC2648B" w14:textId="77777777" w:rsidR="007243AC" w:rsidRDefault="007243AC" w:rsidP="007243AC"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Generated an updated diagram. Please check</w:t></w:r></w:p></w:comment><w:comment w:id="93" w:author="Chris Katigbak" w:date="2026-08-07T09:09:00Z" w:initials="CK"><w:p w14:paraId="3C9C440B" w14:textId="77777777" w:rsidR="005C2B63" w:rsidRDefault="005C2B63" w:rsidP="005C2B63"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>The diagram needs to be updated (remove Palo Alto and kiosk to use zscaler client) if we are going to use the local breakout for all traffic. Is there an editable file?</w:t></w:r></w:p></w:comment><w:comment w:id="95" w:author="Chris Katigbak" w:date="2026-08-12T09:57:00Z" w:initials="CK"><w:p w14:paraId="25185A6F" w14:textId="77777777" w:rsidR="00766F64" w:rsidRDefault="00766F64" w:rsidP="00766F64"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>This needs to be updated with specifics after the testing</w:t></w:r></w:p></w:comment><w:comment w:id="96" w:author="Nick Dorbie" w:date="2026-08-11T10:49:00Z" w:initials="ND"><w:p w14:paraId="7659ADE0" w14:textId="5239820C" w:rsidR="007E7A7F" w:rsidRDefault="007E7A7F"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r w:rsidRPr="4561DD57"><w:t>Is this required? Speed limiting is not set on current machines in the field.</w:t></w:r></w:p></w:comment><w:comment w:id="97" w:author="Shaun Struik" w:date="2026-08-11T11:54:00Z" w:initials="SS"><w:p w14:paraId="44054FCF" w14:textId="35A7D94C" w:rsidR="00F63F1C" w:rsidRDefault="00F63F1C" w:rsidP="00F63F1C"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Nick.Dorbie@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="98" w:name="_@_DA6636209BC74B5182B3203A9DF2EABFZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="98"/><w:r w:rsidRPr="00F63F1C"><w:rPr><w:rStyle w:val="Mention"/><w:noProof/></w:rPr><w:t>@Nick Dorbie</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve"> true, can be deleted, I don’t think max bandwidth control is our issue</w:t></w:r></w:p></w:comment><w:comment w:id="100" w:author="Chris Katigbak" w:date="2026-08-06T09:15:00Z" w:initials="CK"><w:p w14:paraId="1BCDAEB9" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:t>Using Zscaler client with local breakout vs the Palos in azure would need deeper analysis due to potential performance considerations. All azure bound traffic goes into the VMX then to the FW in my understanding.</w:t></w:r></w:p><w:p w14:paraId="3CB4AA53" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"/><w:p w14:paraId="57D211F2" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:t>Local breakout might be a better choice depending on the number of sites to avoid potential bottleneck in the azure.</w:t></w:r></w:p></w:comment><w:comment w:id="101" w:author="David Badger" w:date="2026-08-06T11:37:00Z" w:initials="DB"><w:p w14:paraId="796EC5C4" w14:textId="7FC56DC7" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:Chris.Katigbak@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="106" w:name="_@_89F0153D66224BDFBE1536252DA848E8Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="106"/><w:r w:rsidRPr="280313EF"><w:rPr><w:noProof/></w:rPr><w:t>@Chris Katigbak</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="738E3CFA"><w:t xml:space="preserve"> - please redesign as you see best fit for the solution that meets criteria.</w:t></w:r></w:p></w:comment><w:comment w:id="102" w:author="Chris Katigbak" w:date="2026-08-06T14:24:00Z" w:initials="CK"><w:p w14:paraId="4761C977" w14:textId="5C52AFB3" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:t xml:space="preserve">Hi </w:t></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Phil.Death@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="107" w:name="_@_BB9CE12AAAC24B9ABC4E5E5B99007AE2Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="107"/><w:r w:rsidRPr="00BD5B80"><w:rPr><w:noProof/></w:rPr><w:t>@Phil</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t>, from Zscaler / security perspective, is there any concern taking this local breakout path?</w:t></w:r></w:p><w:p w14:paraId="0D7AA610" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"/><w:p w14:paraId="35416065" w14:textId="50BAD175" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:David.Badger@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="108" w:name="_@_86025C8045FB444D845E22DD7D4EC56DZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="108"/><w:r w:rsidRPr="00BD5B80"><w:rPr><w:noProof/></w:rPr><w:t>@David</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t>, how many sites are we deploying this?</w:t></w:r></w:p><w:p w14:paraId="281BDF74" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"/><w:p w14:paraId="50583A09" w14:textId="4EB4D596" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:t xml:space="preserve">Any thoughts </w:t></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText>HYPERLINK "mailto:Nick.Dorbie@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="109" w:name="_@_E75C2E29FFCF409FA48F7F9103EC5EACZ"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="109"/><w:r w:rsidRPr="00BD5B80"><w:rPr><w:noProof/></w:rPr><w:t>@Nick</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t>?</w:t></w:r></w:p><w:p w14:paraId="63B73D64" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"/><w:p w14:paraId="26CBB68B" w14:textId="77777777" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:t>Thanks all.</w:t></w:r></w:p></w:comment><w:comment w:id="103" w:author="Phil De'ath" w:date="2026-08-06T12:56:00Z" w:initials="PD"><w:p w14:paraId="0F626D79" w14:textId="75BD6EC7" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r w:rsidRPr="002FC85D"><w:t>The Zscaler client on the kiosk machines will tunnel the web traffic directly to the zscaler cloud, this is the model we use for all roaming users at the moment.</w:t></w:r></w:p><w:p w14:paraId="52ADE3DF" w14:textId="19A4BB3C" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r w:rsidRPr="7857C684"><w:t>As the accounts will be local and there is a conditional access policy (in this design from memory) to prevent any APM Entra users from logging on and connecting back to the Azure/M365 environment, this should be ok.</w:t></w:r></w:p></w:comment><w:comment w:id="104" w:author="David Badger" w:date="2026-08-06T15:48:00Z" w:initials="DB"><w:p w14:paraId="7A689932" w14:textId="6D6F9328" w:rsidR="00E44021" w:rsidRDefault="00E44021"><w:r><w:annotationRef/></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> HYPERLINK "mailto:Chris.Katigbak@apm.net.au"</w:instrText></w:r><w:bookmarkStart w:id="110" w:name="_@_D6AF8099E9A8488CA4A46064BE862A30Z"/><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:bookmarkEnd w:id="110"/><w:r w:rsidRPr="2D8EDAB1"><w:rPr><w:noProof/></w:rPr><w:t>@Chris Katigbak</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidRPr="38514828"><w:t xml:space="preserve"> 273 sites</w:t></w:r></w:p><w:p w14:paraId="6CF0DC83" w14:textId="4CC15B42" w:rsidR="00E44021" w:rsidRDefault="00E44021"/></w:comment><w:comment w:id="105" w:author="Chris Katigbak" w:date="2026-08-07T09:23:00Z" w:initials="CK"><w:p w14:paraId="330E12CB" w14:textId="77777777" w:rsidR="00B56883" w:rsidRDefault="00B56883" w:rsidP="00B56883"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Assuming max 20Mbps full load this would be ~ 5.4G and 2.7G azure bound traffic at 100% and 50% utilisation.</w:t></w:r></w:p></w:comment><w:comment w:id="113" w:author="Chris Katigbak" w:date="2026-08-12T10:23:00Z" w:initials="CK"><w:p w14:paraId="721AD7A8" w14:textId="77777777" w:rsidR="00AB1B2E" w:rsidRDefault="00AB1B2E" w:rsidP="00AB1B2E"><w:pPr><w:pStyle w:val="CommentText"/></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>I’ve copilot generated a new diagram below. Please review</w:t></w:r></w:p></w:comment><w:comment w:id="114" w:author="Chris Katigbak" w:date="2026-08-07T09:24:00Z" w:initials="CK"><w:p w14:paraId="75BC4A08" w14:textId="77777777" w:rsidR="00E94536" w:rsidRDefault="00E94536" w:rsidP="00E94536"><w:pPr><