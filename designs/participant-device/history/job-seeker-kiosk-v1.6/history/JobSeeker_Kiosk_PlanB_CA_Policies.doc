h2{font-family:"Poppins","Calibri",sans-serif;color:#1F2D58;font-size:14pt;margin:20pt 0 8pt;border-bottom:2pt solid #F89728;padding-bottom:3pt;}
h3{font-family:"Poppins","Calibri",sans-serif;color:#1F2D58;font-size:11pt;margin:14pt 0 2pt;}
p{margin:0 0 8pt;}
.meta{color:#5A6B9E;font-size:9.5pt;margin:0 0 2pt;}
.fn{font-family:"Poppins","Calibri",sans-serif;color:#F89728;font-size:9pt;font-weight:bold;text-transform:uppercase;letter-spacing:.4pt;margin:0 0 6pt;}
