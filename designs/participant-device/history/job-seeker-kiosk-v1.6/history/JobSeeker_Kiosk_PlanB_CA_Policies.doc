<head><meta charset="utf-8"><title>APM — Kiosk Plan B Conditional Access Policy Set</title>
<!--[if gte mso 9]><xml><w:WordDocument><w:View>Print</w:View><w:Zoom>100</w:Zoom></w:WordDocument></xml><![endif]-->
<style>
@page{size:A4;margin:2cm 2cm 2cm 2cm;}
body{font-family:"Mulish","Calibri",sans-serif;font-size:10.5pt;color:#26304d;line-height:1.45;}
