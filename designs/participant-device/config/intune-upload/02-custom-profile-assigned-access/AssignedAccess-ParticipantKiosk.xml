<?xml version="1.0" encoding="utf-8" ?>
<!-- APM Participant Kiosk - multi-app Assigned Access, per-device local session account.

     THIS FILE IS THE CANONICAL REFERENCE COPY. It is NOT uploaded to Intune.

     The session account name is per device (Kiosk-<SERIAL>), so no single payload can serve
     the fleet: a custom OMA-URI profile sends one identical value to every device and
     performs no token substitution. The account is created on the device and this
     configuration is applied on the device, both by
     CDG-W11-REM-Kiosk Session Account-P-1.0, which owns
     ./Vendor/MSFT/AssignedAccess/Configuration outright.

     PATHS ARE LITERAL, NOT %ProgramFiles%. Environment variables in DesktopAppPath expand
     differently inside the restricted shell than they do for an administrator, and an allowed
     app whose generated rule does not match the path the shell launches is denied with
     nothing the participant can see. Measured on a reference device: LibreOffice would not
     launch with variables and launches with literal paths. The remediation expands
     $env:ProgramFiles, ${env:ProgramFiles(x86)} and $env:SystemRoot at render time, so it
     stays portable while the applied configuration carries literal paths. The values shown
     below are what those expand to on the standard Dell build.

     THE LIBREOFFICE DEPENDENCIES ARE REQUIRED. Assigned Access generates one AppLocker rule
     per listed file, and Microsoft states that where an app depends on another, both must
     appear in the allowed list. soffice.bin is the process that draws the window; the three
     files after it raised AppLocker audit events on the reference device. The remediation
     discovers them rather than hardcoding the path, because the bundled Python folder carries
     a version number that changes with every LibreOffice update. The version below is
     illustrative.

     The remediation carries its own copy of the body in a here-string, because an Intune
     remediation is a single pasted script and cannot read a sibling file at runtime. The two
     have drifted apart once already, with different namespace prefixes on the same element.
     After editing either one, run check-assigned-access.js: it compares them and fails on any
     structural difference.

     [SERIAL] is the substitution point. It is never uploaded or applied literally: a literal
     [SERIAL] resolves to no account, and Assigned Access fails the whole configuration when
     the account does not exist.

     Element order inside Profile is fixed by the schema and must not be reordered:
     AllAppsList, FileExplorerNamespaceRestrictions, StartLayout, StartPins, Taskbar.
     Taskbar pinning is not supported in a restricted user experience, so there is
     deliberately no TaskbarLayout element. -->
<AssignedAccessConfiguration
xmlns="http://schemas.microsoft.com/AssignedAccess/2017/config"
xmlns:rs5="http://schemas.microsoft.com/AssignedAccess/201810/config"
xmlns:v3="http://schemas.microsoft.com/AssignedAccess/2020/config"
xmlns:v5="http://schemas.microsoft.com/AssignedAccess/2022/config">
<Profiles>
<Profile Id="{4B1E9A0C-6D7F-4A31-9C52-8E0A73B5D411}" Name="APM Participant Kiosk">
<AllAppsList>
<AllowedApps>
<App DesktopAppPath="C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe" />
<App DesktopAppPath="C:\Program Files (x86)\Microsoft\Edge\Application\msedge_proxy.exe" />
<!-- Edge's Start menu shortcut resolves to Edge's packaged app identity, not to msedge.exe.
     Assigned Access filters Start against the allowed-app list and matches Edge on that
     identity, so without this AUMID the pin is dropped even though both executables above
     are allowed and the shortcut exists. -->
<App AppUserModelId="Microsoft.MicrosoftEdge.Stable_8wekyb3d8bbwe!App" />
<!-- THE EDGE START PIN DOES NOT USE THE AUMID ABOVE. Start surfaces Edge as a classic desktop
     app on this build, so the pin below names the AppID Get-StartApps reports:
     {7C5A40EF-A0FB-4BFC-874A-C0F2E0B9FA8E}\Microsoft\Edge\Application\msedge.exe, where the
     GUID is the Known Folder ID for Program Files (x86). Measured, not guessed: a
     desktopAppLink to Microsoft Edge.lnk, and a packagedAppId naming the AUMID, were both
     tested and both dropped after a restart. The AUMID entry above still belongs here, because
     Microsoft documents it as required for Edge secondary tiles. Re-measure the pin value with
     Get-StartApps if Edge ever installs into a different Program Files tree. -->
<App DesktopAppPath="C:\Program Files\LibreOffice\program\swriter.exe" />
<App DesktopAppPath="C:\Program Files\LibreOffice\program\scalc.exe" />
<App DesktopAppPath="C:\Program Files\LibreOffice\program\simpress.exe" />
<App DesktopAppPath="C:\Program Files\LibreOffice\program\soffice.exe" />
<App DesktopAppPath="C:\Program Files\LibreOffice\program\soffice.bin" />
<App DesktopAppPath="C:\Program Files\LibreOffice\program\LanguageToolLO.dll" />
<App DesktopAppPath="C:\Program Files\LibreOffice\program\python-core-3.12.13\lib\select.pyd" />
<App DesktopAppPath="C:\Program Files\LibreOffice\program\python-core-3.12.13\lib\_socket.pyd" />
<App DesktopAppPath="C:\Program Files\Zscaler\ZSATray\ZSATray.exe" />
<App DesktopAppPath="C:\Program Files\TeamViewer\TeamViewer.exe" />
<App DesktopAppPath="C:\WINDOWS\System32\Narrator.exe" />
<App DesktopAppPath="C:\WINDOWS\System32\Magnify.exe" />
<App DesktopAppPath="C:\WINDOWS\System32\osk.exe" />
<App DesktopAppPath="C:\WINDOWS\System32\VoiceAccess.exe" />
<App DesktopAppPath="C:\WINDOWS\explorer.exe" />
</AllowedApps>
</AllAppsList>
<!-- Downloads is the only named folder the schema accepts (enumeration
     allowedFileExplorerNamespaceValues_t has exactly one value), and only one
     AllowedNamespace element is permitted. Desktop cannot be granted here. -->
<rs5:FileExplorerNamespaceRestrictions>
<rs5:AllowedNamespace Name="Downloads" />
<v3:AllowRemovableDrives />
</rs5:FileExplorerNamespaceRestrictions>
<v5:StartPins><![CDATA[{"pinnedList":[{"desktopAppId":"{7C5A40EF-A0FB-4BFC-874A-C0F2E0B9FA8E}\\Microsoft\\Edge\\Application\\msedge.exe"},{"desktopAppLink":"%ALLUSERSPROFILE%\\Microsoft\\Windows\\Start Menu\\Programs\\LibreOffice\\LibreOffice Writer.lnk"},{"desktopAppLink":"%ALLUSERSPROFILE%\\Microsoft\\Windows\\Start Menu\\Programs\\LibreOffice\\LibreOffice Calc.lnk"},{"desktopAppLink":"%ALLUSERSPROFILE%\\Microsoft\\Windows\\Start Menu\\Programs\\LibreOffice\\LibreOffice Impress.lnk"},{"desktopAppLink":"%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\File Explorer.lnk"},{"desktopAppLink":"%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\Accessibility\\Narrator.lnk"},{"desktopAppLink":"%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\Accessibility\\Magnify.lnk"},{"desktopAppLink":"%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\Accessibility\\On-Screen Keyboard.lnk"},{"desktopAppLink":"%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\Accessibility\\VoiceAccess.lnk"}]}]]></v5:StartPins>
<Taskbar ShowTaskbar="true" />
</Profile>
</Profiles>
<Configs>
<Config>
<!-- .\Name is a documented local-account form (devicename\user, .\user and user are all
     accepted). The .\ form is used because it depends on neither the computer name nor a
     prefix. Kiosk- plus a 6-character Dell service tag is 12 characters, inside the
     20-character SAM limit; the remediation caps the serial at 14, so the longest name the
     rule can produce is exactly 20. The device is named APM-PK-<SERIAL> from the same
     service tag, deliberately a different name, so no local account collides with it. -->
<Account>.\Kiosk-[SERIAL]</Account>
<DefaultProfile Id="{4B1E9A0C-6D7F-4A31-9C52-8E0A73B5D411}" />
</Config>
</Configs>
</AssignedAccessConfiguration>
